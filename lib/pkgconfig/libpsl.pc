prefix=/usr
exec_prefix=/usr
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: libpsl
Description: Public Suffix List C library.
Version: 0.23.3
URL: https://github.com/rockdaboot/libpsl
Requires: 
Requires.private: libidn2
Libs: -L${libdir} -lpsl 
Libs.private: -lunistring  
Cflags: -I${includedir} 

